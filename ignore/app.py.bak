        with st.spinner("Analyzing Resume..."):
            resume_text = extract_pdf_text(uploaded_resume)
            ats_response = get_ats_feedback(resume_text, jd_input)

        st.markdown("---")
        st.markdown("###  ATS Evaluation Results")
        st.code(ats_response, language='json')
